# ============================================================
# AI Resume Project — .gitignore
# ============================================================

# --- Python Virtual Environment ---
venv/
.venv/
env/

# --- Python Cache Files ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Python Distribution / Packaging ---
build/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg

# --- Node.js & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Build Outputs ---
dist/
dist-ssr/
Frontend/dist/
Backend/dist/
*.local

# ============================================================
# SECRETS & ENVIRONMENT VARIABLES — NEVER COMMIT THESE
# ============================================================

# All .env files are ignored by default ...
.env
.env.*

# ... EXCEPT .env.example files (safe templates with no real secrets)
!.env.example
!**/.env.example

# Explicit per-folder coverage (belt-and-suspenders)
Frontend/.env
Frontend/.env.local
Frontend/.env.development
Frontend/.env.production
Backend/.env
Backend/.env.local

# Firebase service account key (contains private key — extremely sensitive)
**/serviceAccountKey.json
firebase-adminsdk-*.json

# ============================================================
# LARGE BINARIES & TOOLS
# ============================================================
Backend/poppler/
*.zip
*.exe
*.dll
*.so

# ============================================================
# OS JUNK FILES
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# IDE & EDITOR SETTINGS
# ============================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ============================================================
# MISC / AUTO-GENERATED DOCS
# ============================================================

update-firebase-config.ps1