# ============================================================
# Backend Environment Variables — TEMPLATE (safe to commit)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna Job Search API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Firebase Service Account (for production/Render — paste full JSON as single line)
# On local dev, leave this blank and use serviceAccountKey.json file instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS: Your deployed frontend URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=

# OCR Binary Paths
# Windows: set full path e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Render: set to just "tesseract" (it's on PATH)
TESSERACT_CMD=tesseract

# Poppler binary directory
# Windows: set to your poppler bin folder e.g. C:\poppler\bin
# Linux / Render: leave blank (poppler-utils is installed on system PATH)
POPPLER_PATH=
